{
  "$comment": [
    "Blueprint allowlist (§20.9, §68.2). The attestor signs claims only for",
    "entries listed here, and only for the exact pinned slug — never `latest`.",
    "",
    "`status` is load-bearing, not documentation. While it is \"pending\", the",
    "real ZK Email verifier refuses to run: the slug below has not been",
    "compiled on registry.zk.email yet, so accepting proofs against it would",
    "mean verifying nothing. Flip to \"pinned\" only once the slug resolves and",
    "issuerDomain matches the DKIM d= the blueprint actually pins."
  ],
  "blueprints": [
    {
      "key": "flight-cancel-v1",
      "status": "pending",
      "slug": "mailproof/FlightCancellation@v1",
      "claimType": "FLIGHT_CANCELLED",
      "issuerDomain": "demo-airline.example",
      "campaigns": [
        "mailproof-demo-2608071839"
      ],
      "requiredOutputs": [
        "cancellationMarker",
        "uniqueClaimId"
      ],
      "markerOutput": "cancellationMarker",
      "uniqueIdOutput": "uniqueClaimId",
      "markerPattern": "^Your flight [A-Z0-9-]{2,12} has been cancelled\\.?$"
    },
    {
      "key": "flight-cancel-edu-dkim-v1",
      "status": "pinned",
      "slug": "mailproof/FlightCancelledEduDkim@v1",
      "claimType": "FLIGHT_CANCELLED",
      "issuerDomain": "udesa.edu.ar",
      "campaigns": [
        "mailproof-demo-260808014749"
      ],
      "requiredOutputs": [
        "cancellationMarker",
        "uniqueClaimId"
      ],
      "markerOutput": "cancellationMarker",
      "uniqueIdOutput": "uniqueClaimId",
      "markerPattern": "^Your flight [A-Z0-9-]{2,12} has been cancelled\\.?$",
      "dkim": {
        "dnsRecord": "v=DKIM1; k=rsa; ",
        "selector": "google"
      }
    },
    {
      "key": "udesa-domain",
      "status": "pinned",
      "slug": "mailproof/DomainMembership@v1",
      "proves": "domain-membership",
      "claimType": "FLIGHT_CANCELLED",
      "issuerDomain": "udesa.edu.ar",
      "campaigns": [
        "mailproof-demo-260808055530"
      ],
      "dkim": {
        "dnsRecord": "v=DKIM1; k=rsa; ",
        "selector": "google"
      }
    }
  ]
}
