# MailProof configuration (Appendix A).
# Copy to .env and fill in. .env is gitignored; this file must never contain
# a real secret.

# ─── Network ─────────────────────────────────────────────────────────────────
# undeployed = local devnet (docker compose). Also: preview, preprod.
MIDNIGHT_NETWORK=undeployed

# ─── Attestor signing key ────────────────────────────────────────────────────
# Set exactly one. Both derive the same kind of Jubjub scalar.
#   MAILPROOF_ATTESTOR_SEED         any string, up to 32 bytes
#   MAILPROOF_ATTESTOR_PRIVATE_KEY  32 bytes of hex
#
# Leaving both unset is allowed ONLY on the local devnet, where a published
# demo key is used and announced on startup. Every other network fails closed.
# Never give this value to the frontend.
MAILPROOF_ATTESTOR_SEED=
MAILPROOF_ATTESTOR_KEY_ID=demo-v1

# ─── Claim pinning ───────────────────────────────────────────────────────────
# These fix what the deployed contract will accept. Changing any of them
# requires redeploying: they are baked into the contract at construction.
MAILPROOF_CAMPAIGN_ID=travel-insurance-demo-2026
MAILPROOF_CLAIM_TYPE=FLIGHT_CANCELLED
MAILPROOF_BLUEPRINT_ID=mailproof/FlightCancellation@v1
# The DKIM d= domain the blueprint pins — not the From header.
MAILPROOF_ISSUER_DOMAIN=demo-airline.example

# ─── Attestor service ────────────────────────────────────────────────────────
MAILPROOF_ATTESTOR_URL=http://127.0.0.1:8787
MAILPROOF_MAX_REQUEST_BYTES=5000000
MAILPROOF_REQUEST_TIMEOUT_MS=30000

# ─── Private state ───────────────────────────────────────────────────────────
# Encrypts the local private-state store. Minimum 16 characters.
PRIVATE_STATE_PASSWORD=
