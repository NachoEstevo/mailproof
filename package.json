{
  "name": "mailproof",
  "version": "0.1.0",
  "type": "module",
  "description": "Turn emails into private proofs. ZK Email claims redeemed once on Midnight.",
  "author": "",
  "license": "Apache-2.0",
  "scripts": {
    "compile": "compact compile contracts/mailproof.compact contracts/managed/mailproof",
    "setup": "npx tsx src/setup.ts",
    "deploy": "npx tsx src/deploy.ts",
    "cli": "npx tsx src/cli.ts",
    "check-balance": "npx tsx src/check-balance.ts",
    "network": "npx tsx src/network.ts",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "rm -rf contracts/managed .midnight-state.json .midnight-wallet-state",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/e2e-check.ts",
    "e2e:claim": "tsx scripts/e2e-claim.ts",
    "eml:inspect": "tsx scripts/inspect-eml.ts",
    "verify": "npm run typecheck && npm run test",
    "attestor:dev": "tsx services/attestor/src/server.ts",
    "attestor:test": "vitest run services/attestor",
    "contract:test": "vitest run contracts/tests"
  },
  "comments": {
    "overrides": [
      "onchain-runtime-v3 exposes WASM classes (StateValue, ChargedState).",
      "Two copies in the tree means two class identities, and passing an",
      "object from one to the other fails an instanceof check deep inside the",
      "transaction builder ('expected instance of StateValue').",
      "compact-runtime@0.16.0 asks for ^3.0.0 and npm resolved it to 3.1.0,",
      "while midnight-js-protocol@4.1.1 pins exactly 3.0.0 and got a nested",
      "copy. 3.0.0 satisfies both, so pinning it collapses them into one."
    ]
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@scure/bip39": "2.2.0",
    "@zk-email/sdk": "2.0.11",
    "fastify": "5.11.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "midnight",
    "zk-email",
    "dkim",
    "zero-knowledge",
    "privacy",
    "compact"
  ]
}
