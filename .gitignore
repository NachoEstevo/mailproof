# Secrets and environment
.env
.env.*
!.env.example
*.pem
*.key

# Midnight local state — .midnight-state.json holds wallet seeds and the
# 24-word recovery phrase. Never commit it.
.midnight-state.json
.midnight-wallet-state/
deployment.json

# Private email fixtures — never commit a real .eml.
# Synthetic demo fixtures under fixtures/emails/ are allowed (see §75).
fixtures/private-emails/
*.eml
!fixtures/emails/*.eml

