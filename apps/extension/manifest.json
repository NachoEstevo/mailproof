{
  "manifest_version": 3,
  "name": "MailProof",
  "version": "0.1.0",
  "description": "Turn a DKIM-signed email into a private, one-time claim redeemed on Midnight.",
  "key": "",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:3000/*",
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "MailProof \u2014 verify this email"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content-gmail.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
